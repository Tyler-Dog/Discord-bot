DISCORD_TOKEN=your_bot_token_here
# Optional: sync slash commands instantly to one server while developing
GUILD_ID=

# --- AI (all optional; without a key the AI features are simply disabled) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# AI_DAILY_LIMIT=40            # requests per user per day for /ask and /summarize (0 = unlimited)

# --- Privileged intent (enable it in the Developer Portal first) ---
# Needed for /summarize and AutoMod's invite/blocked-word filters.
# MESSAGE_CONTENT_INTENT=true

# --- Web dashboard (http://localhost:8787 by default) ---
# DASHBOARD_ENABLED=true
# DASHBOARD_PORT=8787          # change this if the port is already taken on your PC
# DASHBOARD_HOST=127.0.0.1     # only this computer. Hosting online? see docs/HOSTING.md
# DASHBOARD_TOKEN=             # secret password; REQUIRED when DASHBOARD_HOST is not 127.0.0.1

# --- Misc ---
# LOG_FORMAT=json              # structured logs
# LOG_LEVEL=INFO
# DATA_DIR=./data
